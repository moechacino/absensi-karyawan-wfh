# Public client values: Vite embeds VITE_* variables in the browser bundle.
# Never put credentials, access tokens, signing keys, or other secrets here.
VITE_API_BASE_URL=/api/v1
VITE_APP_URL=http://localhost:5173

# Vite dev-server only; not included in the browser bundle. No path rewrite.
API_PROXY_TARGET=http://localhost:3000
